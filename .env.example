# Copy to .env on the server and fill in.

# Your public address, used for canonical links, Open Graph and the sitemap.
# Set it before `npm run build`.
SITE_URL=https://your-domain.ir

# Login codes by SMS. Without any key, codes are shown on screen (dev and
# DEMO_MODE only; real production refuses to start without SMS or live mode).
#
# SMS.ir: API key from the panel, and the id of an approved "verify" template
# whose text has one parameter, e.g. "کد ورود شما به دیجی قرض: #CODE#".
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_TEMPLATE_PARAM=CODE
# A Sandbox key delivers nothing: set this so the code is also shown on
# screen. SMSIR_TEMPLATE_ID can then stay empty (the sandbox's 123456).
SMSIR_SANDBOX=
#
# Or Kavenegar: API key and a "verify lookup" template containing %token%.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=sandogh-login

PORT=3000
# Production mode (Secure cookies, refuses unsafe settings). The Docker image sets it.
# APP_ENV=production
# In development, where Vite forwards /api (the backend's address).
# API_URL=http://localhost:3000

# Where the data lives. With DATABASE_URL set, it's PostgreSQL (use this
# when the app's own disk doesn't survive a deploy). Otherwise it's a
# SQLite file at DB_PATH.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
DB_PATH=data/sandogh.db

# Digipay: empty = simulator, "live" = real adapter (needs the mini-app SDK).
DIGIPAY_MODE=
# Admin panel sign-in (#/ops). In production the password must be at
# least 10 characters. Without these, the panel falls back to phone access:
# anyone in development/DEMO_MODE, OPS_PHONES in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Phones allowed into the ops panel in production, comma-separated.
OPS_PHONES=
# Minutes a new group has to fill up before it expires (target at maturity: 5).
CIRCLE_FORM_TIMEOUT_MIN=60

# Public demo on the simulator: shows login codes on screen, allows
# sim-<phone> logins and opens the ops panel to everyone. Never for real users.
DEMO_MODE=
